# Absolute path to your Obsidian vault on disk
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/Obsidian/Vault

# Provider selection (only "openai" supported in MVP)
LLM_PROVIDER=openai
STT_PROVIDER=openai
WEB_SEARCH_PROVIDER=tavily

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL_CHAT=gpt-4.1
OPENAI_MODEL_CHAT_FAST=gpt-4o-mini
OPENAI_MODEL_CHAT_STANDARD=gpt-4.1
OPENAI_MODEL_CHAT_REASONING=gpt-5.2
OPENAI_MODEL_ROUTER=gpt-4.1-mini
OPENAI_MODEL_STT=gpt-4o-mini-transcribe
MODEL_ROUTING_ENABLED=true
MODEL_DYNAMIC_ESCALATION_ENABLED=true
MODEL_ROUTING_STICKY_TURNS=3
MODEL_ROUTING_HIGH_PROMPT_TOKENS=40000
FILE_AUTO_READ_MAX_CHARS=1000
FILE_PREVIEW_TOTAL_CHARS=1500
TASK_ARCHIVE_DONE_THRESHOLD=50
DATA_CONCEPT_DECOMPOSITION_THRESHOLD_CHARS=3000
TAVILY_API_KEY=tvly-...

# Logging (optional)
#   LOG_LEVEL  = debug | info | warn | error   (default: info)
#   LOG_FORMAT = pretty | json                  (default: pretty)
# Set LOG_LEVEL=debug to see per-request start frames + token-stream chunks.
LOG_LEVEL=info
LOG_FORMAT=pretty
