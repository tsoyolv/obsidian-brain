# Absolute path to your Obsidian vault on disk
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/Obsidian/Vault

# Provider selection (only "openai" supported in MVP)
LLM_PROVIDER=openai
STT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL_CHAT=gpt-5.2
OPENAI_MODEL_STT=gpt-4o-mini-transcribe

# Logging (optional)
#   LOG_LEVEL  = debug | info | warn | error   (default: info)
#   LOG_FORMAT = pretty | json                  (default: pretty)
# Set LOG_LEVEL=debug to see per-request start frames + token-stream chunks.
LOG_LEVEL=info
LOG_FORMAT=pretty
